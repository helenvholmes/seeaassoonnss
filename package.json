{
  "name": "seasons",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.mjs",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.ts",
    "doctor": "tsx --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/doctor.ts",
    "vercel-build": "node scripts/migrate.mjs && next build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@react-three/fiber": "^9.8.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "d3-geo": "^3.1.1",
    "draco3dgltf": "^1.5.9",
    "heic2any": "^0.0.4",
    "mediabunny": "^1.61.6",
    "meshoptimizer": "^1.3.0",
    "next": "^15.5.28",
    "p5": "^2.3.4",
    "postgres": "^3.4.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-moveable": "^0.56.0",
    "remark-breaks": "^4.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/draco3dgltf": "^1.4.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.32"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/helenvholmes/seasons.git"
  }
}
