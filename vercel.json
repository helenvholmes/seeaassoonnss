{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": { "claude/**": false }
  },
  "redirects": [
    {
      "source": "/seasons/about",
      "has": [{ "type": "host", "value": "seeaassoonnss.app" }],
      "destination": "/about",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "seeaassoonnss.app" }],
      "destination": "/seasons/about"
    },
    {
      "source": "/about",
      "has": [{ "type": "host", "value": "seeaassoonnss.app" }],
      "destination": "/seasons/about"
    },
    {
      "source": "/((?!$|seasons(?:/|$)|about$|_vercel(?:/|$)).*)",
      "destination": "/seasons/page-not-found"
    }
  ]
}
