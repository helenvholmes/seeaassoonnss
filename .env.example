# Copy to .env.local for development. Set the same variables in Vercel for production.
# Secrets (never commit them; mark them Sensitive in Vercel): DATABASE_URL, SETUP_TOKEN,
# R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY.

# Postgres connection string (for example from Neon).
DATABASE_URL=postgres://seasons:seasons@localhost:5432/seasons

# Public URL of the site visitors use, without the /seasons part.
# Passkeys are bound to this domain, so sign in through it, not the *.vercel.app URL.
SITE_URL=http://localhost:3000

# One-time token that allows registering a passkey when you are not signed in.
# Needed for the first passkey on a new deployment, and for recovery if you lose every passkey.
# Each token works once. Generate one with: openssl rand -base64 32
SETUP_TOKEN=

# Link target for "Seasons is open source". Point it at your fork.
SOURCE_URL=https://github.com/helenvholmes/seasons

# Media storage: "r2" in production, "local" for development without R2.
STORAGE_DRIVER=local

# Cloudflare R2 (only when STORAGE_DRIVER=r2).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private bucket: original uploads.
R2_PRIVATE_BUCKET=seasons-originals
# Public bucket: processed images that visitors load.
R2_PUBLIC_BUCKET=seasons-media
# Public URL of the public bucket (custom domain or r2.dev URL), no trailing slash.
R2_PUBLIC_URL=
